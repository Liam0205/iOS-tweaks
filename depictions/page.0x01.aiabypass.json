      "views": [{"class": "DepictionMarkdownView", "markdown": "\u7ed5\u8fc7\u53cb\u90a6\u53cb\u4eab\uff08com.aia.china.YoubangHealthRelease\uff09\u7684\u8d8a\u72f1\u73af\u5883\u68c0\u6d4b\u3002\u76ee\u6807 App \u5185\u7f6e JMCodeProtectKit \u4ee3\u7801\u4fdd\u62a4 SDK\uff0c\u68c0\u6d4b\u547d\u4e2d\u540e\u8df3\u8f6c\u5230\u975e\u6cd5\u5730\u5740\u4f7f\u8fdb\u7a0b SIGSEGV \u9000\u51fa\u3002\u9002\u7528\u4e8e rootless \u8d8a\u72f1\uff08Dopamine \u7b49\uff09\u3002\u5728\u53cb\u90a6\u53cb\u4eab 6.9.33 \u7248\u672c\u9a8c\u8bc1\u3002"}],
